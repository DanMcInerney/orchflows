            "Q-07": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jurisdiction", "age_policy", "children_policy", "privacy_policy", "consent_policy",
                "advertising_policy", "payments_policy", "telemetry_policy", "replay_policy",

            "orch-research-pack", "orch-content-pack", "orch-code-pack",
            "orch-design-pack"
          ]
        },
        "run_identity": {"$ref": "#/$defs/stableIdentity"},
        "root_identity": {"$ref": "#/$defs/stableIdentity"},

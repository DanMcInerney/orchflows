{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchflows.dev/schemas/browser-game/program-record/v1.json",
  "title": "Browser-game versioned program-record contract",
  "description": "The observable PJ-03 program-record contract. Required record kinds and minimum fields come from the authoritative browser-game workflow specification section 3.2; PJ-07 requires every unresolved material value to retain a stable open-question or decision identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "program_id",
    "program_revision_id",
    "supersedes_program_revision_id",
    "records"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "program_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "program_revision_id": {
      "$ref": "#/$defs/stableIdentity"
    },
    "supersedes_program_revision_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/stableIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_brief",
        "decision_ledger",
        "risk_register",
        "support_contracts",
        "experiment_register",
        "asset_contracts",
        "performance_contracts",
        "qa_oracle_map",
        "release_contracts",
        "successor_plans"
      ],
      "properties": {
        "product_brief": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/productBriefRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "decision_ledger": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/decisionRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "risk_register": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/riskRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "support_contracts": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/supportContractRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "experiment_register": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/experimentRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "asset_contracts": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/assetContractRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "performance_contracts": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/performanceContractRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "qa_oracle_map": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/qaOracleRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "release_contracts": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/releaseContractRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        },
        "successor_plans": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "entries"],
              "properties": {
                "state": {"const": "present"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/successorPlanRevision"}
                }
              }
            },
            {"$ref": "#/$defs/openQuestion"},
            {"$ref": "#/$defs/openDecision"}
          ]
        }
      }
    }
  },
  "$defs": {
    "stableIdentity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "open_question_id", "authority_kind"],
      "properties": {
        "state": {"const": "open-question"},
        "open_question_id": {"$ref": "#/$defs/stableIdentity"},
        "authority_kind": {"enum": ["user-only", "empirical"]}
      }
    },
    "openDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decision_id"],
      "properties": {
        "state": {"const": "decision"},
        "decision_id": {"$ref": "#/$defs/stableIdentity"}
      }
    },
    "materialField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": {"const": "settled"},
            "value": {},
            "settled_by": {"const": "verbatim-user-answer"},
            "verbatim_user_answer": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "open_question_id", "authority_kind"],
          "properties": {
            "state": {"const": "open-question"},
            "open_question_id": {"$ref": "#/$defs/stableIdentity"},
            "authority_kind": {"enum": ["user-only", "empirical"]},
            "kind": {"enum": ["user-only", "empirical"]},
            "question": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decision_id"],
          "properties": {
            "state": {"const": "decision"},
            "decision_id": {"$ref": "#/$defs/stableIdentity"}
          }
        }
      ]
    },
    "recordRevision": {
      "type": "object",
      "x-governing-identities": ["PJ-03", "PJ-07"],
      "required": [
        "record_id",
        "revision_id",
        "revision_status",
        "supersedes_revision_id",
        "recorded_at"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/stableIdentity"},
        "revision_id": {"$ref": "#/$defs/stableIdentity"},
        "revision_status": {"enum": ["draft", "settled", "superseded"]},
        "supersedes_revision_id": {
          "oneOf": [
            {"$ref": "#/$defs/stableIdentity"},
            {"type": "null"}
          ]
        },
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "productBriefField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "disposition",
        "resolution",
        "authority_source",
        "authority_kind",
        "owner",
        "rationale",
        "evidence",
        "revision"
      ],
      "properties": {
        "field_id": {"$ref": "#/$defs/stableIdentity"},
        "disposition": {
          "enum": ["answered", "deferred", "experiment", "not-applicable"]
        },
        "resolution": {"$ref": "#/$defs/materialField"},
        "authority_source": {
          "enum": [
            "product_intent",
            "commercial_or_legal_acceptance",
            "accessibility_promises",
            "risk_appetite",
            "target_cohorts",
            "public_release_commitments",
            "empirical-evidence"
          ]
        },
        "authority_kind": {"enum": ["user-only", "empirical"]},
        "verbatim_question": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/materialField"},
        "rationale": {"$ref": "#/$defs/materialField"},
        "evidence": {"$ref": "#/$defs/materialField"},
        "revision": {"$ref": "#/$defs/stableIdentity"}
      }
    },
    "productBriefRevision": {
      "type": "object",
      "x-governing-identities": ["PJ-03", "PJ-06", "PJ-09", "PJ-10"],
      "allOf": [{"$ref": "#/$defs/recordRevision"}],
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Q-01", "Q-02", "Q-03", "Q-04", "Q-05", "Q-06",
            "Q-07", "Q-08", "Q-09", "Q-10", "Q-11", "Q-12"
          ],
          "properties": {
            "Q-01": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "player", "audience", "genre", "core_loop", "target_browser_cohorts",
                "target_os_cohorts", "target_device_cohorts", "target_webview_cohorts",
                "target_pwa_cohorts", "display_modes", "input_modes", "support_horizon"
              ],
              "properties": {
                "player": {"$ref": "#/$defs/productBriefField"},
                "audience": {"$ref": "#/$defs/productBriefField"},
                "genre": {"$ref": "#/$defs/productBriefField"},
                "core_loop": {"$ref": "#/$defs/productBriefField"},
                "target_browser_cohorts": {"$ref": "#/$defs/productBriefField"},
                "target_os_cohorts": {"$ref": "#/$defs/productBriefField"},
                "target_device_cohorts": {"$ref": "#/$defs/productBriefField"},
                "target_webview_cohorts": {"$ref": "#/$defs/productBriefField"},
                "target_pwa_cohorts": {"$ref": "#/$defs/productBriefField"},
                "display_modes": {"$ref": "#/$defs/productBriefField"},
                "input_modes": {"$ref": "#/$defs/productBriefField"},
                "support_horizon": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-02": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimensional_scope", "engine", "renderer", "editor", "physics", "app_shell",
                "dependency_assembly", "commercial_license_constraints"
              ],
              "properties": {
                "dimensional_scope": {"$ref": "#/$defs/productBriefField"},
                "engine": {"$ref": "#/$defs/productBriefField"},
                "renderer": {"$ref": "#/$defs/productBriefField"},
                "editor": {"$ref": "#/$defs/productBriefField"},
                "physics": {"$ref": "#/$defs/productBriefField"},
                "app_shell": {"$ref": "#/$defs/productBriefField"},
                "dependency_assembly": {"$ref": "#/$defs/productBriefField"},
                "commercial_license_constraints": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-03": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "representative_slice", "corpus", "device_lab_evidence", "boot_budget",
                "memory_budget", "cpu_budget", "gpu_budget", "frame_budget", "input_budget",
                "network_budget", "thermal_budget", "power_budget", "quality_budget", "bundle_budget"
              ],
              "properties": {
                "representative_slice": {"$ref": "#/$defs/productBriefField"},
                "corpus": {"$ref": "#/$defs/productBriefField"},
                "device_lab_evidence": {"$ref": "#/$defs/productBriefField"},
                "boot_budget": {"$ref": "#/$defs/productBriefField"},
                "memory_budget": {"$ref": "#/$defs/productBriefField"},
                "cpu_budget": {"$ref": "#/$defs/productBriefField"},
                "gpu_budget": {"$ref": "#/$defs/productBriefField"},
                "frame_budget": {"$ref": "#/$defs/productBriefField"},
                "input_budget": {"$ref": "#/$defs/productBriefField"},
                "network_budget": {"$ref": "#/$defs/productBriefField"},
                "thermal_budget": {"$ref": "#/$defs/productBriefField"},
                "power_budget": {"$ref": "#/$defs/productBriefField"},
                "quality_budget": {"$ref": "#/$defs/productBriefField"},
                "bundle_budget": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-04": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_corpus", "image_recipe", "texture_recipe", "audio_recipe", "video_recipe",
                "font_recipe", "localization_recipe", "legal_provenance", "quality_thresholds",
                "content_bundles", "content_lifetimes", "shader_pipeline"
              ],
              "properties": {
                "asset_corpus": {"$ref": "#/$defs/productBriefField"},
                "image_recipe": {"$ref": "#/$defs/productBriefField"},
                "texture_recipe": {"$ref": "#/$defs/productBriefField"},
                "audio_recipe": {"$ref": "#/$defs/productBriefField"},
                "video_recipe": {"$ref": "#/$defs/productBriefField"},
                "font_recipe": {"$ref": "#/$defs/productBriefField"},
                "localization_recipe": {"$ref": "#/$defs/productBriefField"},
                "legal_provenance": {"$ref": "#/$defs/productBriefField"},
                "quality_thresholds": {"$ref": "#/$defs/productBriefField"},
                "content_bundles": {"$ref": "#/$defs/productBriefField"},
                "content_lifetimes": {"$ref": "#/$defs/productBriefField"},
                "shader_pipeline": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-05": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "player_mode", "authority_model", "transport", "tick_model", "snapshot_model",
                "rollback_model", "anti_cheat", "ugc", "backend", "cloud_save_conflicts",
                "recovery", "server_operations"
              ],
              "properties": {
                "player_mode": {"$ref": "#/$defs/productBriefField"},
                "authority_model": {"$ref": "#/$defs/productBriefField"},
                "transport": {"$ref": "#/$defs/productBriefField"},
                "tick_model": {"$ref": "#/$defs/productBriefField"},
                "snapshot_model": {"$ref": "#/$defs/productBriefField"},

          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableIdentity"}
        },
        "current_status": {"enum": ["planned", "opened"]}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_kind": {"const": "research"}}},
          "then": {"properties": {"pack": {"const": "orch-research-pack"}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "prose"}}},
          "then": {"properties": {"pack": {"const": "orch-content-pack"}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "code"}}},
          "then": {"properties": {"pack": {"const": "orch-code-pack"}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "rendered-interface"}}},
          "then": {"properties": {"pack": {"const": "orch-design-pack"}}}
        }
      ]

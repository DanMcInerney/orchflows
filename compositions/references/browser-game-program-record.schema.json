                "retention": {"$ref": "#/$defs/productBriefField"},
                "data_residency": {"$ref": "#/$defs/productBriefField"},
                "incident_notification": {"$ref": "#/$defs/productBriefField"},
                "providers": {"$ref": "#/$defs/productBriefField"},
                "sla_obligations": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-08": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "offline_mode", "pwa_mode", "cdn", "hosting", "rollout", "rollout_cohort",
                "cache_policy", "service_worker_policy", "state_migration", "rollback_window",
                "rpo", "rto", "incident_drills"
              ],
              "properties": {
                "offline_mode": {"$ref": "#/$defs/productBriefField"},
                "pwa_mode": {"$ref": "#/$defs/productBriefField"},
                "cdn": {"$ref": "#/$defs/productBriefField"},
                "hosting": {"$ref": "#/$defs/productBriefField"},
                "rollout": {"$ref": "#/$defs/productBriefField"},
                "rollout_cohort": {"$ref": "#/$defs/productBriefField"},
                "cache_policy": {"$ref": "#/$defs/productBriefField"},
                "service_worker_policy": {"$ref": "#/$defs/productBriefField"},
                "state_migration": {"$ref": "#/$defs/productBriefField"},

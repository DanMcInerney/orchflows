                "anti_cheat": {"$ref": "#/$defs/productBriefField"},
                "ugc": {"$ref": "#/$defs/productBriefField"},
                "backend": {"$ref": "#/$defs/productBriefField"},
                "cloud_save_conflicts": {"$ref": "#/$defs/productBriefField"},
                "recovery": {"$ref": "#/$defs/productBriefField"},
                "server_operations": {"$ref": "#/$defs/productBriefField"}
              }
            },
            "Q-06": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accessibility_conformance_target", "browser_at_matrix", "caption_design",
                "narration_design", "spatial_assist_design", "timing_tradeoffs",
                "difficulty_tradeoffs", "competitive_tradeoffs", "participant_cohorts",
                "residual_exclusions"
              ],
              "properties": {
                "accessibility_conformance_target": {"$ref": "#/$defs/productBriefField"},
                "browser_at_matrix": {"$ref": "#/$defs/productBriefField"},
                "caption_design": {"$ref": "#/$defs/productBriefField"},
                "narration_design": {"$ref": "#/$defs/productBriefField"},

    "managed_markers": {
      "host_instructions": {
        "end": "<!-- END ORCHFLOWS -->",
        "mode": "owned-file",
        "start": "<!-- BEGIN ORCHFLOWS (managed block \u2014 do not edit inside; reinstall to update) -->",
        "target": "rules/orchflows.md"
      },
      "subagent_limits": {
        "end": "# END ORCHFLOWS SUBAGENT LIMITS",
        "mode": "owned-prefix",
        "start": "# BEGIN ORCHFLOWS SUBAGENT LIMITS",
        "target": "config.toml"
      }
    },
    "role_profiles": {
      "planner": {
        "binding": {
          "effort": "xhigh",
          "model": "grok-4.6",
          "subagent_type": "orch-planner"
        },
        "name": "orch-planner"
      },
      "worker": {
        "binding": {
          "effort": "high",
          "model": "grok-4.6",
          "subagent_type": "orch-worker"
        },
        "name": "orch-worker"
      }
    },
    "schema_version": 1
  },

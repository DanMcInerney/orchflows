{
  "adapter_version": 1,
  "host": {
    "capabilities": {
      "effort": "native",
      "isolation": "native"
    },
    "cli_candidates": [
      "grok",
      "grok.exe",
      "grok.cmd"
    ],
    "display_name": "Grok Build",

{
  "schema": "orchflows.workflow-summary.v1",
  "workflows": {
    "bakeoff": {
      "nodes": [
        {"id": "label", "label": "Label the candidates"},
        {"id": "candidates", "label": "Make every candidate at once"},
        {"id": "score", "label": "Score the lines against a rubric"},
        {"id": "winner", "label": "Unblind and name the winner"}
      ],
      "edges": [
        {"source": "label", "target": "candidates", "kind": "sequence"},
        {"source": "candidates", "target": "score", "kind": "sequence"},
        {"source": "score", "target": "winner", "kind": "sequence"}
      ]
    },
    "browser-game": {
      "nodes": [
        {"id": "record", "label": "Establish the program record"},
        {"id": "evidence", "label": "Resolve empirical questions"},
        {"id": "checkpoint", "label": "Fix the checkpoint disposition"},
        {"id": "successors", "label": "Authorize successor delivery"}
      ],
      "edges": [
        {"source": "record", "target": "evidence", "kind": "sequence"},
        {"source": "evidence", "target": "checkpoint", "kind": "sequence"},
        {"source": "checkpoint", "target": "successors", "kind": "branch"}
      ]
    },
    "benchmaker": {
      "nodes": [
        {"id": "acquire", "label": "Acquire fixed evidence"},
        {"id": "design", "label": "Freeze the evaluation"},
        {"id": "materialize", "label": "Build the benchmark"},
        {"id": "qualify", "label": "Qualify its discrimination"},
        {"id": "audit", "label": "Audit the boundaries"},
        {"id": "measure", "label": "Measure final resolution"}
      ],
      "edges": [
        {"source": "acquire", "target": "design", "kind": "sequence"},
        {"source": "design", "target": "materialize", "kind": "sequence"},
        {"source": "materialize", "target": "qualify", "kind": "sequence"},
        {"source": "qualify", "target": "audit", "kind": "sequence"},
        {"source": "audit", "target": "measure", "kind": "sequence"}
      ]
    },
    "evolve": {
      "nodes": [
        {"id": "evaluation", "label": "Freeze the evaluation"},
        {"id": "incumbent", "label": "Admit the incumbent"},
        {"id": "mutations", "label": "Create bounded candidates"},
        {"id": "judge", "label": "Score candidates blind"},
        {"id": "select", "label": "Promote the best result"}
      ],
      "edges": [
        {"source": "evaluation", "target": "incumbent", "kind": "sequence"},
        {"source": "incumbent", "target": "mutations", "kind": "sequence"},
        {"source": "mutations", "target": "judge", "kind": "sequence"},
        {"source": "judge", "target": "select", "kind": "sequence"},
        {"source": "select", "target": "mutations", "kind": "loop"}
      ]
    },
    "drift-canary": {
      "nodes": [
        {"id": "replay", "label": "Replay the canary set"},
        {"id": "compare", "label": "Compare golden results"},
        {"id": "report", "label": "Report behavior drift"}
      ],
      "edges": [
        {"source": "replay", "target": "compare", "kind": "sequence"},
        {"source": "compare", "target": "report", "kind": "sequence"}
      ]
    },
    "renovate": {
      "nodes": [
        {"id": "audit", "label": "Audit the workspace"},
        {"id": "triage", "label": "Triage the findings"},
        {"id": "deliver", "label": "Deliver ready improvements"}
      ],
      "edges": [
        {"source": "audit", "target": "triage", "kind": "sequence"},
        {"source": "triage", "target": "deliver", "kind": "sequence"}
      ]
    },
    "self-improve": {
      "nodes": [
        {"id": "mine", "label": "Mine run and friction evidence"},
        {"id": "qualify", "label": "Qualify one proposal"},
        {"id": "deliver", "label": "Land the owner change"}
      ],
      "edges": [
        {"source": "mine", "target": "qualify", "kind": "sequence"},
        {"source": "qualify", "target": "deliver", "kind": "sequence"}
      ]
    },
    "skill-tournament": {
      "nodes": [
        {"id": "benchmark", "label": "Build a qualified benchmark"},
        {"id": "campaign", "label": "Evolve skill candidates"},
        {"id": "promote", "label": "Promote the winning skill"}
      ],
      "edges": [
        {"source": "benchmark", "target": "campaign", "kind": "sequence"},
        {"source": "campaign", "target": "campaign", "kind": "loop"},
        {"source": "campaign", "target": "promote", "kind": "sequence"}
      ]
    },
    "super-research": {
      "nodes": [
        {"id": "acquire", "label": "Acquire public records"},
        {"id": "report", "label": "Cite, date, and declare gaps"}
      ],
      "edges": [
        {"source": "acquire", "target": "report", "kind": "sequence"}
      ]
    },
    "orch-judge": {
      "nodes": [
        {"id": "ledger", "label": "Read the fixed review ledger"},
        {"id": "challenge", "label": "Challenge artifact evidence"},
        {"id": "verdict", "label": "Record blockers or verdict"}
      ],
      "edges": [
        {"source": "ledger", "target": "challenge", "kind": "sequence"},
        {"source": "challenge", "target": "verdict", "kind": "sequence"}
      ]
    },
    "checkpointed-build": {
      "nodes": [
        {"id": "plan", "label": "Cut the build into waves"},
        {"id": "waves", "label": "Make each wave in isolation"},
        {"id": "judge", "label": "Judge the joined tip"},
        {"id": "repair", "label": "Repair the named blocks"}
      ],
      "edges": [
        {"source": "plan", "target": "waves", "kind": "sequence"},
        {"source": "waves", "target": "judge", "kind": "sequence"},
        {"source": "judge", "target": "repair", "kind": "branch"},
        {"source": "repair", "target": "judge", "kind": "loop"}
      ]
    },
    "orch-do": {
      "nodes": [
        {"id": "resolve", "label": "Resolve the stamped standard"},
        {"id": "apply", "label": "Apply execute cells"},
        {"id": "evidence", "label": "Record artifact evidence"}
      ],
      "edges": [
        {"source": "resolve", "target": "apply", "kind": "sequence"},
        {"source": "apply", "target": "evidence", "kind": "sequence"}
      ]
    }
  }
}

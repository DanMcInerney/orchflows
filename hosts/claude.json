{
  "schema_version": 1,
  "id": "claude",
  "display_name": "Claude Code",
  "cli_candidates": ["claude", "claude.exe", "claude.cmd"],
  "home": {"environment": "CLAUDE_CONFIG_DIR", "default": ".claude"},
  "managed_markers": {
    "host_instructions": {
      "target": "CLAUDE.md",
      "mode": "import-legacy",
      "start": "<!-- BEGIN ORCHFLOWS (managed block — do not edit inside; reinstall to update) -->",
      "end": "<!-- END ORCHFLOWS -->"
    }
  },
  "installed_items": {
    "skill": "skills/{name}/SKILL.md",
    "role_agent": "agents/{profile}.md",
    "instructions": "CLAUDE.md",
    "settings": "settings.json"
  },
  "frontmatter": {
    "legal_keys": ["name", "description", "context", "agent", "disable-model-invocation"],
    "role_fields": {"context": "fork", "agent": "orch-{role}"}
  },
  "launch": {
    "verb": "Agent",
    "native_fields": ["model", "effort", "context", "agent"]
  },
  "role_profiles": {
    "planner": {
      "name": "orch-planner",
      "binding": {"model": "claude-opus-5", "effort": "max"}
    },
    "worker": {
      "name": "orch-worker",
      "binding": {"model": "claude-sonnet-5", "effort": "xhigh"}
    }
  },
  "capabilities": {"isolation": "requested", "effort": "native"}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchflows.local/3d-browser-game/evidence-index/v1.json",
  "title": "3D browser-game evidence index",
  "description": "Typed, hashed evidence paths bound to one artifact commit or a declared ancestor.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "artifact_commit", "created_at", "producer", "inputs", "environment", "status", "gaps", "invalidates", "declared_ancestors", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "kind": {"const": "evidence-index"}, "id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/producer"}, "inputs": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/inputs"}, "environment": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/environment"}, "status": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/status"}, "gaps": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/gaps"}, "invalidates": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/invalidates"},
    "declared_ancestors": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}}, "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}}, "required": {"type": "array", "uniqueItems": true, "items": {"oneOf": [{"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "kind": {"type": "string"}}}]}}, "required_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {"kind": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}}, "outside_probe": {"$ref": "#/$defs/outsideProbe"}, "promotion": {"$ref": "#/$defs/promotion"}
  },
  "allOf": [{"if": {"required": ["status"], "properties": {"status": {"const": "complete"}}}, "then": {"required": ["promotion"], "properties": {"promotion": {"$ref": "#/$defs/promotion"}}}}],
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"},
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256", "revision"], "properties": {"id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "path": {"$ref": "#/$defs/relativePath"}, "kind": {"enum": ["brief", "amendment", "research", "concept", "traceability", "increment", "asset", "manifest", "run-record", "play-session", "capture", "capture-matrix", "performance", "performance-plan", "verdict", "repair", "other"]}, "sha256": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/sha256"}, "revision": {"enum": ["same-artifact", "declared-ancestor"]}, "source_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}}},
    "outsideProbe": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "config": {"$ref": "https://orchflows.local/3d-browser-game/outside-probe/v1.json"},
        "config_path": {"$ref": "#/$defs/relativePath"},
        "config_sha256": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/sha256"},
        "result": {"$ref": "https://orchflows.local/3d-browser-game/outside-probe/v1.json#/$defs/result"},
        "result_path": {"$ref": "#/$defs/relativePath"},
        "result_sha256": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/sha256"}
      },
      "oneOf": [
        {"required": ["config"], "not": {"required": ["config_path"]}},
        {"required": ["config_path"], "not": {"required": ["config"]}}
      ],
      "allOf": [
        {"if": {"required": ["result_path"]}, "then": {"required": ["result_sha256"]}},
        {"if": {"required": ["result_sha256"]}, "then": {"required": ["result_path"]}}
      ]
    },
    "promotion": {"type": "object", "additionalProperties": false, "required": ["validator", "observed_at", "result_identity"], "properties": {"validator": {"const": "validate_evidence.mjs"}, "observed_at": {"type": "string", "format": "date-time"}, "result_identity": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/sha256"}}}
  }
}

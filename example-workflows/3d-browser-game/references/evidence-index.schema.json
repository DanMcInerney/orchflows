{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchflows.local/3d-browser-game/evidence-index/v1.json",
  "title": "3D browser-game evidence index",
  "description": "Typed, hashed evidence paths bound to one artifact commit or a declared ancestor.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "artifact_commit", "created_at", "producer", "inputs", "environment", "status", "gaps", "invalidates", "declared_ancestors", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "kind": {"const": "evidence-index"}, "id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/producer"}, "inputs": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/inputs"}, "environment": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/environment"}, "status": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/status"}, "gaps": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/gaps"}, "invalidates": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/invalidates"},
    "declared_ancestors": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}}, "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}}, "promotion": {"$ref": "#/$defs/promotion"}
  },
  "allOf": [{"if": {"required": ["status"], "properties": {"status": {"const": "complete"}}}, "then": {"required": ["promotion"]}}],
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"},
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256", "revision"], "properties": {"path": {"$ref": "#/$defs/relativePath"}, "kind": {"enum": ["brief", "amendment", "research", "concept", "traceability", "increment", "asset", "manifest", "play-session", "capture", "performance", "verdict", "repair", "other"]}, "sha256": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/sha256"}, "revision": {"enum": ["same-artifact", "declared-ancestor"]}, "source_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}}},
    "promotion": {"type": "object", "additionalProperties": false, "required": ["validator", "observed_at", "result_identity"], "properties": {"validator": {"const": "validate_evidence.mjs"}, "observed_at": {"type": "string", "format": "date-time"}, "result_identity": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}}
  }
}

  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "artifact_commit", "created_at", "producer", "inputs", "environment", "status", "gaps", "invalidates", "gate", "fixed_inputs", "hard_gates", "scores", "strengths", "complaints", "contrary_evidence", "confidence", "disposition", "resume_state"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "kind": {"const": "gate-verdict"}, "id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/producer"}, "inputs": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/inputs"}, "environment": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/environment"}, "status": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/status"}, "gaps": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/gaps"}, "invalidates": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/invalidates"},
    "gate": {"enum": ["core", "final"]}, "fixed_inputs": {"$ref": "#/$defs/fixedInputs"}, "hard_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hardGate"}}, "scores": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/score"}}, "strengths": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}, "complaints": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/complaint"}}, "contrary_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "disposition": {"enum": ["pass", "fix", "redesign", "unverified"]}, "resume_state": {"$ref": "#/$defs/resume"}
  },
  "$defs": {
    "fixedInputs": {"type": "object", "additionalProperties": false, "required": ["artifact_commit", "evidence_index", "traceability", "rubric_revision", "capture_matrix", "play_sessions", "performance_plan", "performance_cells"], "properties": {"artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"}, "evidence_index": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "traceability": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "rubric_revision": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "capture_matrix": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "play_sessions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "performance_plan": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "performance_cells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "final_boss_promised": {"type": "boolean"}, "accepted_core_verdict": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "core_gate_verdict": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "core_verdict": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "concept_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "concept_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "asset_manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "asset_manifest_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "changed_mechanics": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}, "affected_core_reproof": {"$ref": "https://orchflows.local/3d-browser-game/lineage/v1.json#/$defs/reproof"}, "core_reproof": {"$ref": "https://orchflows.local/3d-browser-game/lineage/v1.json#/$defs/reproof"}, "run_record": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "predecessor_run_record": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}},
    "hardGate": {"type": "object", "additionalProperties": false, "required": ["id", "name", "result", "evidence"], "properties": {"id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "name": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}, "result": {"enum": ["pass", "fail", "unverified"]}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}}},
    "score": {"type": "object", "additionalProperties": false, "required": ["dimension", "score", "evidence", "rationale"], "properties": {"dimension": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "score": {"type": "integer", "minimum": 0, "maximum": 4}, "floor": {"type": "integer", "const": 3}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "rationale": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}},
    "complaint": {"type": "object", "additionalProperties": false, "required": ["id", "seam", "kind", "cause", "evidence", "expected_improvement"], "properties": {"id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "seam": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}, "kind": {"enum": ["defect", "unverified", "preference"]}, "cause": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}, "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "expected_improvement": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["identity", "observation"], "properties": {"identity": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "observation": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}},
    "resume": {"type": "object", "additionalProperties": false, "required": ["stage", "cursor", "open_complaint_ids", "next_action"], "properties": {"stage": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}, "cursor": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "open_complaint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}}, "next_action": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/nonEmptyString"}}}
  }
}

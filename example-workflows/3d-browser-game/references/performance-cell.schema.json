{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchflows.local/3d-browser-game/performance-cell.schema.json",
  "title": "3d-browser-game performance cell",
  "type": "object",
  "required": ["schema_version", "kind", "id", "artifact_commit", "created_at", "producer", "inputs", "environment", "status", "gaps", "invalidates", "cell", "trace", "callbacks", "measurement", "qualification", "source"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "kind": {"const": "performance-cell"},
    "id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"},
    "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/producer"},
    "inputs": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/inputs"},
    "environment": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/environment"},
    "status": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/status"},
    "gaps": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/gaps"},
    "invalidates": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/invalidates"},
    "cell": {
      "type": "object",
      "required": ["id", "artifact_commit", "scenario_id", "window"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/commit"},
        "scenario_id": {"type": "string", "minLength": 1},
        "seed": {"type": ["string", "number", "integer"]},
        "warmup_seconds": {"type": "number", "minimum": 0},
        "control_duration_ms": {"type": "number", "minimum": 250},
        "warmup_duration_ms": {"type": "number", "minimum": 0},
        "sampling": {"$ref": "#/$defs/sampling"},
        "readback": {
          "type": "object",
          "properties": {"max_pending": {"type": "integer", "minimum": 1, "maximum": 8}},
          "additionalProperties": false
        },
        "window": {
          "type": "object",
          "required": ["start_ms", "end_ms"],
          "properties": {"start_ms": {"type": "number"}, "end_ms": {"type": "number"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": ["traceEvents", "completion"],
      "properties": {"traceEvents": {"type": "array"}, "completion": {"type": "object"}},
      "additionalProperties": true
    },
    "callbacks": {"type": "array"},
    "measurement": {
      "type": "object",
      "required": ["scenario_id", "observer", "presentation", "preserve_drawing_buffer", "warmup", "control", "instrumented", "perturbation"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "observer": {"type": "string", "minLength": 1},
        "presentation": {"type": "string", "minLength": 1},
        "preserve_drawing_buffer": {"type": ["boolean", "null"]},
        "sampling": {"$ref": "#/$defs/sampling"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "warmup": {"$ref": "#/$defs/phase"},
        "control": {"$ref": "#/$defs/phase"},
        "instrumented": {"$ref": "#/$defs/instrumented"},
        "perturbation": {"$ref": "#/$defs/perturbation"}
      },
      "additionalProperties": false
    },
    "qualification": {"type": "object", "required": ["status", "metrics", "failures"], "properties": {"status": {"enum": ["qualified", "unverified"]}, "metrics": {"type": "object"}, "failures": {"type": "array"}}, "additionalProperties": true},
    "source": {"enum": ["live-browser", "qualification-fixture"]},
    "diagnostics": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{
    "if": {"properties": {"source": {"const": "live-browser"}}},
    "then": {
      "properties": {
        "cell": {"required": ["sampling"]},
        "measurement": {"required": ["sampling", "lifecycle"]}
      }
    }
  }],
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["status", "requested_ms", "observed_ms", "callbacks", "callback_rate_hz"],
      "properties": {
        "status": {"enum": ["observed", "fixture", "unverified"]},
        "requested_ms": {"type": "number", "minimum": 0},
        "start_ms": {"type": "number"},
        "end_ms": {"type": "number"},
        "observed_ms": {"type": "number", "minimum": 0},
        "callbacks": {"type": "integer", "minimum": 0},
        "callback_rate_hz": {"type": "number", "minimum": 0},
        "max_callback_interval_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "instrumented": {
      "type": "object",
      "required": ["status", "requested_ms", "observed_ms", "callbacks", "callback_rate_hz", "samples", "readback_errors"],
      "properties": {
        "status": {"enum": ["observed", "fixture", "unverified"]},
        "requested_ms": {"type": "number", "minimum": 0},
        "start_ms": {"type": "number"},
        "end_ms": {"type": "number"},
        "observed_ms": {"type": "number", "minimum": 0},
        "callbacks": {"type": "integer", "minimum": 0},
        "callback_rate_hz": {"type": "number", "minimum": 0},
        "max_callback_interval_ms": {"type": ["number", "null"], "minimum": 0},
        "samples": {"type": "integer", "minimum": 0},
        "readback_errors": {"type": "integer", "minimum": 0},
        "sample_duration_ms": {"$ref": "#/$defs/sampleDuration"},
        "readback": {"$ref": "#/$defs/readback"}
      },
      "additionalProperties": false
    },
    "perturbation": {
      "type": "object",
      "required": ["status", "basis", "control_callbacks", "instrumented_callbacks", "control_callback_rate_hz", "instrumented_callback_rate_hz", "callback_rate_delta_hz", "samples", "readback_errors"],
      "properties": {
        "status": {"enum": ["observed", "fixture", "unverified"]},
        "basis": {"const": "control-vs-instrumented"},
        "control_callbacks": {"type": "integer", "minimum": 0},
        "instrumented_callbacks": {"type": "integer", "minimum": 0},
        "control_callback_rate_hz": {"type": "number", "minimum": 0},
        "instrumented_callback_rate_hz": {"type": "number", "minimum": 0},
        "callback_rate_delta_hz": {"type": "number"},
        "callback_interval_delta_ms": {"type": ["number", "null"]},
        "samples": {"type": "integer", "minimum": 0},
        "readback_errors": {"type": "integer", "minimum": 0},
        "sample_duration_ms": {"$ref": "#/$defs/sampleDuration"},
        "readback": {"$ref": "#/$defs/readback"}
      },
      "additionalProperties": false
    },
    "sampleDuration": {
      "type": "object",
      "required": ["count", "total_ms", "max_ms", "p99_ms"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "total_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": ["number", "null"], "minimum": 0},
        "p99_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "readback": {
      "type": "object",
      "required": ["method", "asynchronous", "api", "max_pending", "allocated_buffers", "queued", "completed", "lost", "errors", "context_losses", "poll_count", "pending_at_cleanup", "cleanup_observed", "queue_duration_ms", "wait_duration_ms", "copy_duration_ms", "poll_duration_ms"],
      "properties": {
        "method": {"const": "webgl2.pixel-pack-buffer+fence-sync"},
        "asynchronous": {"const": true},
        "api": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "max_pending": {"type": "integer", "minimum": 1, "maximum": 8},
        "allocated_buffers": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "lost": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "context_losses": {"type": "integer", "minimum": 0},
        "poll_count": {"type": "integer", "minimum": 0},
        "pending_at_cleanup": {"type": "integer", "minimum": 0},
        "cleanup_observed": {"type": "boolean"},
        "queue_duration_ms": {"type": "number", "minimum": 0},
        "wait_duration_ms": {"type": "number", "minimum": 0},
        "copy_duration_ms": {"type": "number", "minimum": 0},
        "poll_duration_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": ["explicit", "coordinate_space", "requested_region", "resolved_region", "drawing_buffer", "viewport", "dpr", "sample_pixels", "bytes_per_sample", "origin"],
      "properties": {
        "explicit": {"type": "boolean"},
        "coordinate_space": {"enum": ["drawing-buffer", "viewport"]},
        "requested_region": {"$ref": "#/$defs/region"},
        "resolved_region": {"oneOf": [{"$ref": "#/$defs/region"}, {"type": "null"}]},
        "drawing_buffer": {"oneOf": [{"$ref": "#/$defs/size"}, {"type": "null"}]},
        "viewport": {"oneOf": [{"$ref": "#/$defs/size"}, {"type": "null"}]},
        "dpr": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "sample_pixels": {"type": "integer", "minimum": 1},
        "bytes_per_sample": {"type": "integer", "minimum": 4},
        "origin": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "scenario_id", "configured_url", "reset", "phase_transitions"],
      "properties": {
        "status": {"enum": ["observed", "fixture"]},
        "scenario_id": {"type": "string", "minLength": 1},
        "seed": {"type": ["string", "number", "null"]},
        "configured_url": {"type": ["string", "null"]},
        "viewport": {"$ref": "#/$defs/size"},
        "dpr": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "start": {"type": "object"},
        "reset": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "phase_transitions": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchflows.local/3d-browser-game/performance-cell.schema.json",
  "title": "3d-browser-game performance cell",
  "type": "object",
  "required": ["schema_version", "kind", "id", "artifact_commit", "created_at", "producer", "inputs", "environment", "status", "gaps", "invalidates", "cell", "trace", "callbacks", "qualification", "source"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"}, "kind": {"const": "performance-cell"}, "id": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "artifact_commit": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/identity"}, "created_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/producer"}, "inputs": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/inputs"}, "environment": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/environment"}, "status": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/status"}, "gaps": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/gaps"}, "invalidates": {"$ref": "https://orchflows.local/3d-browser-game/common/v1.json#/$defs/invalidates"},
    "cell": {"type": "object", "required": ["id", "artifact_commit", "window"], "properties": {"id": {"type": "string"}, "artifact_commit": {"type": "string"}, "window": {"type": "object", "required": ["start_ms", "end_ms"], "properties": {"start_ms": {"type": "number"}, "end_ms": {"type": "number"}}, "additionalProperties": false}}, "additionalProperties": true},
    "trace": {"type": "object", "required": ["traceEvents", "completion"], "properties": {"traceEvents": {"type": "array"}, "completion": {"type": "object"}}, "additionalProperties": true},
    "callbacks": {"type": "array"}, "qualification": {"type": "object", "required": ["status", "metrics", "failures"], "properties": {"status": {"enum": ["qualified", "unverified"]}, "metrics": {"type": "object"}, "failures": {"type": "array"}}, "additionalProperties": true},
    "source": {"enum": ["live-browser", "qualification-fixture"]},
    "diagnostics": {"type": "object"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

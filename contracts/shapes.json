{
  "schema_version": 1,
  "constants": {
    "dispatch_protocol": "orchflows.dispatch.v1",
    "outcome_record_id": "outcome",
    "packet_record_id": "dispatch-packet",
    "review_protocol": "orchflows.review.v1"
  },
  "shapes": [
    {
      "name": "dispatch_state",
      "contract": "dispatch.md",
      "fields": ["protocol", "attempts"],
      "required": ["protocol", "attempts"],
      "values": {"protocol": ["orchflows.dispatch.v1"]}
    },
    {
      "name": "dispatch_attempt",
      "contract": "dispatch.md",
      "fields": [
        "assignment_seal", "dispatch_id", "lease_expires_at", "opened_at",
        "outcome_record_id", "owner", "records", "state", "workspace_path",
        "retired_at",
        "retirement", "replaced_at", "replaced_by", "replacement", "replaces"
      ],
      "required": [
        "assignment_seal", "dispatch_id", "lease_expires_at", "opened_at",
        "outcome_record_id", "owner", "records", "state"
      ],
      "values": {
        "state": ["live", "retired", "replaced"],
        "outcome_record_id": ["outcome"]
      }
    },
    {
      "name": "dispatch_record",
      "contract": "dispatch.md",
      "fields": ["committed_at", "content", "kind", "record_id", "success"],
      "required": ["committed_at", "content", "kind", "record_id", "success"],
      "values": {"kind": ["generic", "packet", "result", "outcome", "join", "lifecycle"]}
    },
    {
      "name": "dispatch_stored_success",
      "contract": "dispatch.md",
      "fields": ["committed_record"],
      "required": ["committed_record"]
    },
    {
      "name": "dispatch_committed_record",
      "contract": "dispatch.md",
      "fields": ["protocol", "run", "id", "dispatch_id", "record_id", "content"],
      "required": ["protocol", "run", "id", "dispatch_id", "record_id", "content"]
    },
    {
      "name": "dispatch_packet_record",
      "contract": "dispatch.md",
      "fields": ["packet"],
      "required": ["packet"]
    },
    {
      "name": "dispatch_result_record",
      "contract": "dispatch.md",
      "fields": ["assignment_seal", "body", "mode", "operation", "section", "writer"],
      "required": ["assignment_seal", "body", "mode", "operation", "section", "writer"]
    },
    {
      "name": "dispatch_result_success",
      "contract": "dispatch.md",
      "fields": ["result"],
      "required": ["result"]
    },
    {
      "name": "dispatch_result_projection",
      "contract": "dispatch.md",
      "fields": ["protocol", "run", "id", "path", "section", "mode", "by", "assignment_seal", "dispatch_id", "record_id"],
      "required": ["protocol", "run", "id", "path", "section", "mode", "by", "assignment_seal", "dispatch_id", "record_id"]
    },
    {
      "name": "dispatch_transition_success",
      "contract": "dispatch.md",
      "fields": ["dispatch"],
      "required": ["dispatch"]
    },
    {
      "name": "dispatch_retirement_dispatch",
      "contract": "dispatch.md",
      "fields": ["protocol", "outcome", "run", "id", "dispatch_id", "record_id", "retired_at", "state"],
      "required": ["protocol", "outcome", "run", "id", "dispatch_id", "record_id", "retired_at", "state"],
      "values": {"outcome": ["retired"], "state": ["retired"]}
    },
    {
      "name": "dispatch_replacement_dispatch",
      "contract": "dispatch.md",
      "fields": ["protocol", "outcome", "run", "id", "dispatch_id", "record_id", "replaces", "assignment_seal", "lease_expires_at", "opened_at", "state"],
      "required": ["protocol", "outcome", "run", "id", "dispatch_id", "record_id", "replaces", "assignment_seal", "lease_expires_at", "opened_at", "state"],
      "values": {"outcome": ["replaced"], "state": ["live"]}
    },
    {
      "name": "dispatch_join_content",
      "contract": "dispatch.md",
      "fields": ["assignment_seal", "dispatch_id", "joined_by", "operation", "outcome_record_id", "review"],
      "required": ["assignment_seal", "dispatch_id", "joined_by", "operation", "outcome_record_id"]
    },
    {
      "name": "dispatch_retire_request",
      "contract": "dispatch.md",
      "fields": ["assignment_seal", "dispatch_id", "operation"],
      "required": ["assignment_seal", "dispatch_id", "operation"],
      "values": {"operation": ["retire"]}
    },
    {
      "name": "dispatch_replace_request",
      "contract": "dispatch.md",
      "fields": ["assignment_seal", "dispatch_id", "lease_expires_at", "operation", "owner", "replaces"],
      "required": ["assignment_seal", "dispatch_id", "lease_expires_at", "operation", "owner", "replaces"],
      "values": {"operation": ["replace"]}
    },
    {
      "name": "dispatch_join_success",
      "contract": "dispatch.md",
      "fields": ["protocol", "run", "id", "assignment_seal", "dispatch_id", "outcome_record_id", "by", "status", "joined_at", "review_identity"],
      "required": ["protocol", "run", "id", "assignment_seal", "dispatch_id", "outcome_record_id", "by", "status", "joined_at"]
    },
    {
      "name": "dispatch_packet",
      "contract": "dispatch.md",
      "fields": [
        "protocol", "source", "dispatch_id", "assignment_seal",
        "lease_expires_at", "role", "assigned_name", "workspace", "pack",
        "prompt", "review_kind", "durability"
      ],
      "required": [
        "protocol", "source", "dispatch_id", "assignment_seal",
        "lease_expires_at", "role", "assigned_name", "workspace", "pack",
        "prompt", "review_kind", "durability"
      ],
      "values": {
        "durability": ["ticket"],
        "review_kind": ["critique", "repair", "verify", "null"]
      }
    },
    {
      "name": "dispatch_outcome",
      "contract": "dispatch.md",
      "fields": [
        "protocol", "run", "id", "assignment_seal", "dispatch_id",
        "outcome_record_id", "by", "status", "evidence"
      ],
      "required": [
        "protocol", "run", "id", "assignment_seal", "dispatch_id",
        "outcome_record_id", "by", "status", "evidence"
      ],
      "values": {"status": ["complete", "blocked", "stalled", "limited", "failed", "suspended"]}
    },
    {
      "name": "dispatch_outcome_evidence",
      "contract": "dispatch.md",
      "fields": ["Result", "Verification", "Feedback", "Risks", "Handoff"],
      "required": ["Result", "Verification", "Feedback", "Risks", "Handoff"]
    },
    {
      "name": "review_state",
      "contract": "work-item.md",
      "fields": ["protocol", "records"],
      "required": ["protocol", "records"],
      "values": {"protocol": ["orchflows.review.v1"]}
    },
    {
      "name": "review_record_common",
      "contract": "work-item.md",
      "fields": ["identity", "kind", "predecessor", "protocol"],
      "required": ["identity", "kind", "predecessor", "protocol"],
      "values": {"kind": ["GatePlan", "CritiqueAdjudication", "RepairOutcome", "Verification"]}
    },
    {
      "name": "review_gate_plan",
      "contract": "work-item.md",
      "fields": ["artifact", "criteria", "isolation", "mode", "pack", "root", "workspace"],
      "required": ["artifact", "criteria", "isolation", "mode", "pack", "root", "workspace"],
      "values": {"mode": ["gate", "checker"]}
    },
    {
      "name": "review_criterion",
      "contract": "work-item.md",
      "fields": ["identity", "lens", "order", "ticket"],
      "required": ["identity", "lens", "order", "ticket"]
    },
    {
      "name": "review_finding",
      "contract": "work-item.md",
      "fields": ["blocking", "class", "evidence", "goal_impact", "id", "repair", "summary"],
      "required": ["blocking", "class", "evidence", "goal_impact", "id", "repair", "summary"]
    },
    {
      "name": "review_critique",
      "contract": "work-item.md",
      "fields": ["accepted", "adjudicated_by", "artifact", "findings", "lens"],
      "required": ["accepted", "adjudicated_by", "artifact", "findings", "lens"]
    },
    {
      "name": "review_aggregate_critique",
      "contract": "work-item.md",
      "fields": ["accepted", "adjudicated_by", "adjudications", "artifact", "findings", "lens"],
      "required": ["accepted", "adjudicated_by", "adjudications", "artifact", "findings", "lens"]
    },
    {
      "name": "review_repair",
      "contract": "work-item.md",
      "fields": ["accepted", "artifact", "by", "input_artifact", "no_op", "result"],
      "required": ["accepted", "artifact", "by", "input_artifact", "no_op", "result"]
    },
    {
      "name": "review_verification",
      "contract": "work-item.md",
      "fields": ["artifact", "by", "evidence", "verdict", "covers"],
      "required": ["artifact", "by", "evidence", "verdict"],
      "values": {"verdict": ["PASS", "FAIL", "UNVERIFIED"]}
    },
    {
      "name": "ticket_assignment_sections",
      "contract": "work-item.md",
      "fields": ["Goal", "Context", "Suggested files"],
      "required": ["Goal", "Context"]
    },
    {
      "name": "ticket_frontmatter",
      "contract": "work-item.md",
      "fields": [
        "id", "run", "status", "admission", "executor", "pack",
        "profile", "independence", "depends_on", "isolation", "bound", "loop",
        "checked_by", "root_generation", "cut_generation", "assignment_seal",
        "workspace_branch", "workspace_baseline", "dispatch_v1",
        "review_order", "review_v1", "review_stage", "review_kind"
      ],
      "required": ["id", "run", "status", "executor", "depends_on", "bound"],
      "values": {
        "status": ["pending", "ready", "claimed", "suspended", "complete", "blocked", "stalled", "failed", "limited"],
        "review_kind": ["critique", "repair", "verify", "null"]
      }
    },
    {
      "name": "loop_stub",
      "contract": "work-item.md",
      "fields": ["done"],
      "required": ["done"]
    },
    {
      "name": "loop_done",
      "contract": "work-item.md",
      "fields": ["form", "value"],
      "required": ["form", "value"],
      "values": {"form": ["command", "check"]}
    },
    {
      "name": "executor_result",
      "contract": "result.md",
      "fields": ["assignment_seal", "body", "mode", "operation", "section", "writer"],
      "required": ["assignment_seal", "body", "mode", "operation", "section", "writer"],
      "values": {"operation": ["result"], "mode": ["write", "append", "replace"]}
    },
    {
      "name": "verdict_criterion",
      "contract": "verdict.md",
      "fields": ["verdict", "oracle", "oracle_class", "evidence", "covers"],
      "required": ["verdict", "oracle", "oracle_class", "evidence", "covers"],
      "values": {
        "verdict": ["PASS", "FAIL", "UNVERIFIED"],
        "oracle_class": ["deterministic", "judged", "evidence"]
      }
    },
    {
      "name": "worklog_view",
      "contract": "worklog.md",
      "fields": ["goal", "iterations", "failed_approaches", "queued_scope", "terminal"],
      "required": ["goal", "iterations", "failed_approaches", "queued_scope", "terminal"]
    },
    {
      "name": "pack_cells",
      "contract": "pack-signature.md",
      "fields": ["adapter", "stages", "assembly", "craft"],
      "required": ["adapter", "stages", "assembly", "craft"],
      "values": {"assembly": ["none", "stage name"]}
    }
  ]
}

+    def test_timestamp_boundaries_and_reauthentication(self):
+        with patch("inbox.time.time", return_value=1_000_000):
+            for offset in (-300, 0, 300):
+                headers = self.signed(str(offset), timestamp=str(1_000_000 + offset))

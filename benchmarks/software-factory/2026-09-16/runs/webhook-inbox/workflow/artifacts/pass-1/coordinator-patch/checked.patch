+        self.assertEqual(self.post("same", b'{"owner":"beta"}', "beta")[0], 201)
+        self.assertEqual(self.post("Same")[0], 201)
+        self.assertEqual(self.post(tenant="beta", headers=self.signed("cross"))[0], 401)
